{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "username": "thomasmol",
  "share": "manual",
  "plugins": ["@sveltejs/opencode", "opencode-github-panel"],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "systemctl *", "effect": "ask" },
    { "action": "shell", "resource": "service *", "effect": "ask" },
    { "action": "shell", "resource": "kill *", "effect": "ask" },
    { "action": "shell", "resource": "pkill *", "effect": "ask" },
    { "action": "shell", "resource": "killall *", "effect": "ask" },
    { "action": "shell", "resource": "reboot", "effect": "ask" },
    { "action": "shell", "resource": "shutdown", "effect": "ask" },
    { "action": "shell", "resource": "poweroff", "effect": "ask" },
    { "action": "shell", "resource": "crontab *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "mv */.*", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "truncate *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "shred *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs *", "effect": "ask" },
    { "action": "shell", "resource": "ssh *", "effect": "ask" },
    { "action": "shell", "resource": "scp *", "effect": "ask" },
    { "action": "shell", "resource": "rsync *", "effect": "ask" },
    { "action": "shell", "resource": "prisma *", "effect": "ask" },
    { "action": "shell", "resource": "drizzle* *", "effect": "ask" },
    { "action": "shell", "resource": "npx prisma *", "effect": "ask" },
    { "action": "shell", "resource": "bunx prisma *", "effect": "ask" },
    { "action": "shell", "resource": "npm run prisma*", "effect": "ask" },
    { "action": "shell", "resource": "npm run drizzle*", "effect": "ask" },
    { "action": "shell", "resource": "docker *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl *", "effect": "ask" },
    { "action": "shell", "resource": "terraform apply", "effect": "ask" },
    { "action": "shell", "resource": "terraform destroy", "effect": "ask" },
    { "action": "shell", "resource": "helm *", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git tag -d *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr ready*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr close*", "effect": "ask" },
    { "action": "shell", "resource": "gh issue close*", "effect": "ask" },
    { "action": "shell", "resource": "gh issue delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete*", "effect": "deny" },
    { "action": "shell", "resource": "aws *", "effect": "ask" },
    { "action": "shell", "resource": "gcloud *", "effect": "ask" },
    { "action": "shell", "resource": "az *", "effect": "ask" },
    { "action": "shell", "resource": "mysql *", "effect": "ask" },
    { "action": "shell", "resource": "postgres *", "effect": "ask" },
    { "action": "shell", "resource": "psql *", "effect": "ask" },
    { "action": "shell", "resource": "mongod *", "effect": "ask" },
    { "action": "shell", "resource": "redis-cli *", "effect": "ask" },
    { "action": "shell", "resource": "apt *", "effect": "ask" },
    { "action": "shell", "resource": "apt-get *", "effect": "ask" },
    { "action": "shell", "resource": "yum *", "effect": "ask" },
    { "action": "shell", "resource": "dnf *", "effect": "ask" },
    { "action": "shell", "resource": "pacman *", "effect": "ask" },
    { "action": "shell", "resource": "brew *", "effect": "ask" },
    { "action": "shell", "resource": "npm uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "npm uninstall -g *", "effect": "ask" },
    { "action": "shell", "resource": "bun uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "nvm *", "effect": "ask" },
    { "action": "shell", "resource": "rustup *", "effect": "ask" },
    { "action": "shell", "resource": "sdkman *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "stripe *", "effect": "ask" }
  ],
  "agents": {
    "plan": {
      "permissions": [{ "action": "shell", "resource": "*", "effect": "allow" }]
    }
  },
  "providers": {
    "openai": {
      "settings": { "compaction": { "type": "native" } }
    }
  },
  "mcp": {
    "servers": {
      "paper": {
        "type": "remote",
        "url": "http://127.0.0.1:29979/mcp",
        "disabled": true
      },
      "instant_domain_search": {
        "type": "remote",
        "url": "https://mcp.instantdomainsearch.com/mcp",
        "disabled": true
      }
    }
  }
}
